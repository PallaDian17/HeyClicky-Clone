# Copy to apps/backend/.env (gitignored).
PORT=8787

# OpenAI — the only paid dependency in phase 2.
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Supabase JWT verification. Set SUPABASE_URL (JWKS is fetched from it) and,
# for projects still on the legacy HS256 secret, SUPABASE_JWT_SECRET.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=

# Local development only: accept requests without a bearer token.
DEV_BYPASS_AUTH=1

# Dictation (optional): when both are set the app streams to Deepgram; otherwise Apple Speech on-device.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
DEEPGRAM_MODEL=nova-3

# Integrations (optional): Composio project API key. Unset = only custom connectors in Setup.
COMPOSIO_API_KEY=

# Voice previews in onboarding.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
