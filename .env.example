# Copy to .env (gitignored). scripts/build-app.sh bakes these into the app's Info.plist.
# The anon key is a publishable key; row-level security is what protects data.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Where the Mac app finds the backend (apps/backend). Default is the local dev server.
BACKEND_URL=http://localhost:8787

# Add "heyclickyclone://auth/callback" to Authentication -> URL Configuration -> Redirect URLs
# in the Supabase dashboard, and enable the Google provider there if you want "Continue with Google".

# Updates / crash reporting (optional). The Sparkle public key is already the build default.
SPARKLE_FEED_URL=
SPARKLE_PUBLIC_KEY=
SENTRY_DSN=
